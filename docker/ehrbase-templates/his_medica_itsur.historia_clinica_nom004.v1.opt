                </attributes>
                <archetype_id>
                    <value>openEHR-EHR-EVALUATION.smokeless_tobacco_summary.v1</value>
                </archetype_id>
                <term_definitions code="at0001">
                    <items id="text">Tree</items>
                    <items id="description">@ internal @</items>
                </term_definitions>
                <term_definitions code="at0003">
                    <items id="text">Current user</items>
                    <items id="description">The individual is a current user of any type of smokeless tobacco.</items>
                </term_definitions>
                <term_definitions code="at0005">
                    <items id="text">Former user</items>
                    <items id="description">The individual has previously used smokeless tobacco, but is not a current user.</items>
                </term_definitions>
                <term_definitions code="at0006">
                    <items id="text">Never used</items>
                    <items id="description">Individual has never used any type of smokeless tobacco.</items>
                </term_definitions>
                <term_definitions code="at0013">
                    <items id="text">Episode start date</items>
                    <items id="description">Date when this episode commenced.</items>
                    <items id="comment">Can be a partial date, for example, only a year.</items>
                </term_definitions>
                <term_definitions code="at0014">
                    <items id="text">Quit date</items>
                    <items id="description">Date when the individual last used the specified type of tobacco.</items>
                    <items id="comment">Can be a partial date, for example, only a year. Definitions for a 'Quit date' vary enormously and can be defined using the 'Quit data definition' data element in the Protocol section of this archetype. This date will be identical to the 'Episode end date' for the most recent episode. This date could be used by decision support guidance to determine if the individual is at risk of relapse, for example in the first 12 months since quitting.</items>
                </term_definitions>
                <term_definitions code="at0015">
                    <items id="text">Regular use commenced</items>
                    <items id="description">The date or partial date when the individual first started frequent or regular, but non-daily, use of smokeless tobacco of any type.</items>
                    <items id="comment">Can be a partial date, for example, only a year. For example, this date could represent when the individual commenced using smokeless tobacco every Friday night or at parties.</items>
                </term_definitions>
                <term_definitions code="at0016">
                    <items id="text">Overall quit date</items>
                    <items id="description">The date when the individual last ceased using smokeless tobacco of any type.</items>
                    <items id="comment">Can be a partial date, for example, only a year. This date could be used by decision support guidance to determine if the individual is at risk of relapse, for example in the first 12 months since quitting.</items>
                </term_definitions>
                <term_definitions code="at0017">
                    <items id="text">Pack years</items>
                    <items id="description">Estimate of the cumulative amount of smokeless tobacco used over a lifetime, for the specified type of smokeless tobacco.</items>
                    <items id="comment">Commonly used in assessment of snus use. It is calculated by multiplying the number of packs of snus used per day by the number of years the individual has used. One pack-year is the&#13;
equivalent of using one packet of snus daily for 1 year. The definition of a pack can be recorded in the protocol of this archetype using the 'Pack definition' data element.</items>
                </term_definitions>
                <term_definitions code="at0019">
                    <items id="text">Overall comment</items>
                    <items id="description">Additional narrative about all smokeless tobacco use, not captured in other fields.</items>
                    <items id="comment">For example: stopped snusing or reduced amount on becoming pregnant.</items>
                </term_definitions>
                <term_definitions code="at0021">
                    <items id="text">Tree</items>
                    <items id="description">@ internal @</items>
                </term_definitions>
                <term_definitions code="at0022">
                    <items id="text">Last updated</items>
                    <items id="description">The date this smokeless tobacco summary was last updated.</items>
                </term_definitions>
                <term_definitions code="at0023">
                    <items id="text">Typical frequency</items>
                    <items id="description">Estimate of number of times that an individual uses smokeless tobacco per time period.</items>
                    <items id="comment">For example: the number of 'bags', 'pinches' or 'portions' per day or per week.</items>
                </term_definitions>
                <term_definitions code="at0025">
                    <items id="text">Number of quit attempts</items>
                    <items id="description">Total number of times the individual has attempted to stop using the specified type of smokeless tobacco within this episode.</items>
                </term_definitions>
                <term_definitions code="at0026">
                    <items id="text">Episode details</items>
                    <items id="description">Additional structured details about the specified episode of smokeless tobacco use.</items>
                </term_definitions>
                <term_definitions code="at0029">
                    <items id="text">Per type</items>
                    <items id="description">Details about use of a specified type of smokeless tobacco.</items>
                </term_definitions>
                <term_definitions code="at0030">
                    <items id="text">Pattern</items>
                    <items id="description">Details about a discrete period of use of the specified type of smokeless tobacco.</items>
                    <items id="comment">The typical pattern of use can be made more granular by coding the free text option with a terminology or a local value set in a template.</items>
                </term_definitions>
                <term_definitions code="at0043">
                    <items id="text">Overall description</items>
                    <items id="description">Narrative summary about the individual's overall smokeless tobacco use pattern and history.</items>
                    <items id="comment">Use this data element to record a narrative description only where the structured data does not adequately reflect the smokeless tobacco use for this individual or to incorporate unstructured information about smokeless tobacco use from existing or legacy clinical systems into an archetyped format.</items>
                </term_definitions>
                <term_definitions code="at0052">
                    <items id="text">Status</items>
                    <items id="description">Statement about current use of the specified type of smokeless tobacco.</items>
                </term_definitions>
                <term_definitions code="at0053">
                    <items id="text">Description</items>
                    <items id="description">Narrative summary about use of the specified type of smokeless tobacco.</items>
                </term_definitions>
                <term_definitions code="at0059">
                    <items id="text">Former user</items>
                    <items id="description">The individual has previously used the specified smokeless tobacco, but is not a current user.</items>
                </term_definitions>
                <term_definitions code="at0061">
                    <items id="text">Current user</items>
                    <items id="description">The individual is a current user of the specified type of smokeless tobacco.</items>
                </term_definitions>
                <term_definitions code="at0064">
                    <items id="text">Per episode</items>
                    <items id="description">Details about a discrete period of use of the specified type of smokeless tobacco.</items>
                </term_definitions>
                <term_definitions code="at0065">
                    <items id="text">Typical use</items>
                    <items id="description">Estimate of the amount of loose tobacco used.</items>
                </term_definitions>
                <term_definitions code="at0069">
                    <items id="text">Comment</items>
                    <items id="description">Additional narrative about the use of the specified type of smokeless tobacco, not captured in other fields.</items>
                </term_definitions>
                <term_definitions code="at0071">
                    <items id="text">Quit date definition</items>
                    <items id="description">The applied definition for the 'Quit date' data elements used in this archetype.</items>
                </term_definitions>
                <term_definitions code="at0072">
                    <items id="text">Pack definition</items>
                    <items id="description">The definition of the size of pack used as part of the algorithm for calculating 'Pack years' data elements used in this archetype.</items>
                </term_definitions>
                <term_definitions code="at0073">
                    <items id="text">Extension</items>
                    <items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items>
                    <items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items>
                </term_definitions>
                <term_definitions code="at0074">
                    <items id="text">Overall pack years</items>
                    <items id="description">Estimate of the cumulative amount of smokeless tobacco used over a lifetime, for all types of smokeless tobacco.</items>
                    <items id="comment">Commonly used in assessment of snus use. It is calculated by multiplying the number of packs of snus, or other types of smokeless tobacco, used per day by the number of years the individual has used. One pack-year is the&#13;
equivalent of using one packet of smokeless tobacco daily for 1 year. The definition of a pack can be recorded in the protocol of this archetype using the 'Pack definition' data element.</items>
                </term_definitions>
                <term_definitions code="at0075">
                    <items id="text">Current user definition</items>
                    <items id="description">The applied definition for the 'Current user' value in each of the 'Status' data elements used in this archetype.</items>
                    <items id="comment">Definition may need to be specified per type.</items>
                </term_definitions>
                <term_definitions code="at0076">
                    <items id="text">Former user definition</items>
                    <items id="description">The applied definition for the 'Former user' value in each of the 'Status' data elements used in this archetype.</items>
                    <items id="comment">Definition may need to be specified per type.</items>
                </term_definitions>
                <term_definitions code="at0077">
                    <items id="text">Type details</items>
                    <items id="description">Additional structured details relating to the specified type of smokeless tobacco use.</items>
                </term_definitions>
                <term_definitions code="at0079">
                    <items id="text">Never used definition</items>
                    <items id="description">The applied definition for the 'Never used' value in each of the 'Status' data elements used in this archetype.</items>
                    <items id="comment">Definition may need to be specified per type. For example, the definition may not be zero, but less than a specified amount used during a specified time interval.</items>
                </term_definitions>
                <term_definitions code="at0080">
                    <items id="text">Daily use commenced</items>
                    <items id="description">The date or partial date when the individual first started daily use of smokeless tobacco of any type.</items>
                    <items id="comment">Can be a partial date, for example, only a year.</items>
                </term_definitions>
                <term_definitions code="at0081">
                    <items id="text">Episode label</items>
                    <items id="description">Identification of an episode of smokeless tobacco use.</items>
                    <items id="comment">The label may be represented either as a number in a sequence and/or a named event. For example: '2' as the second episode within a sequence of episodes; or 'Pregnancy with twins' if describing the use of smokeless tobacco during a health event such as during a specific pregnancy.</items>
                </term_definitions>
                <term_definitions code="at0082">
                    <items id="text">Episode end date</items>
                    <items id="description">Date when this episode ceased.</items>
                    <items id="comment">Can be a partial date, for example, only a year. This data field will be empty if the episode is current and ongoing.</items>
                </term_definitions>
                <term_definitions code="at0083">
                    <items id="text">Daily</items>
                    <items id="description">Use of the specified type of smokeless tobacco at least once every day.</items>
                </term_definitions>
                <term_definitions code="at0084">
                    <items id="text">Non-daily</items>
                    <items id="description">Not using the specified type of smokeless tobacco every day.</items>
                </term_definitions>
                <term_definitions code="at0085">
                    <items id="text">Quit attempt definition</items>
                    <items id="description">The applied definition for a Quit attempt used to determine value for the 'Number of quit attempts' data element used in this archetype.</items>
                    <items id="comment">For example: 'stopped snusing for one day or longer with the intention of quitting'.</items>
                </term_definitions>
                <term_definitions code="at0086">
                    <items id="text">Overall details</items>
                    <items id="description">Additional structured details about the overall smokeless tobacco use.</items>
                </term_definitions>
                <term_definitions code="at0087">
                    <items id="text">Episode comment</items>
                    <items id="description">Details about a discrete period of use of the specified type of smokeless tobacco.</items>
                </term_definitions>
                <term_definitions code="at0089">
                    <items id="text">Overall status</items>
                    <items id="description">Statement about current use of all types of smokeless tobacco.</items>
                </term_definitions>
                <term_definitions code="at0091">
                    <items id="text">Never used</items>
                    <items id="description">The individual has never used the specified type of smokeless tobacco.</items>
                </term_definitions>
                <term_definitions code="at0098">
                    <items id="text">Type</items>
                    <items id="description">The name of the specific type or grouping of smokeless tobacco.</items>
                    <items id="comment">For example: A specific type could be 'snus' or 'gutka', while a group could be 'chewing tobacco'.</items>
                </term_definitions>
                <term_definitions code="at0000">
                    <items id="text">Smokeless tobacco summary</items>
                    <items id="description">Summary or persistent information about smokeless tobacco use by an individual.</items>
                </term_definitions>
                <term_definitions code="[oz_av]">
                    <items id="text">oz (avoirdupois)</items>
                    <items id="description">ounce</items>
                </term_definitions>
            </children>
